# RecoverAI Environment Configuration Example
# Copy this file to .env and fill in real values. DO NOT commit .env to git.

# Application Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=sqlite:///./recoverai.db

# LLM Provider API Keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Razorpay API Credentials (Test Mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Execution & Policy Safety Parameters
MAX_REAL_PAYMENT_LINKS=10
SIMULATE_OPENAI_FAILURE=false
